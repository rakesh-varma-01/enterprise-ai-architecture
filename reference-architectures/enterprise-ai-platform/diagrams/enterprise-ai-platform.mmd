flowchart TB
    subgraph L1["Layer 1 — Channels and AI experiences"]
        direction LR
        EX1([Employee and customer experiences])
        EX2([APIs and embedded assistants])
    end

    subgraph L2["Layer 2 — Agent and workflow orchestration"]
        direction LR
        OR1([Bounded agent runtime])
        OR2([Workflow state and approvals])
        OR3([Typed tool registry])
    end

    subgraph L3["Layer 3 — AI gateway and model services"]
        direction LR
        MO1([AI gateway and routing])
        MO2([Approved model services])
        MO3([Prompt and configuration registry])
    end

    subgraph L4["Layer 4 — Enterprise context and knowledge"]
        direction LR
        CT1([Authorized retrieval])
        CT2([Evidence and provenance])
        CT3([Knowledge indexes])
    end

    subgraph L5["Layer 5 — Data products, APIs, and operational systems"]
        direction LR
        EN1([Governed data products])
        EN2([APIs and events])
        EN3([Controlled enterprise tools])
    end

    subgraph L6["Layer 6 — Cloud, compute, and AI infrastructure"]
        direction LR
        IN1([Compute and model serving])
        IN2([Network, storage, and secrets])
        IN3([Delivery, resilience, and recovery])
    end

